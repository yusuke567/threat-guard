generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  brands    Brand[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  domain         String
  logoUrl        String?
  keywords       String         @default("")
  detectedDomains DetectedDomain[]
  scanJobs       ScanJob[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([domain])
}

model DetectedDomain {
  id            String          @id @default(uuid())
  brandId       String
  brand         Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain        String
  source        String          @default("manual")
  firstSeen     DateTime        @default(now())
  lastSeen      DateTime        @default(now())
  status        String          @default("new_domain")
  riskScore     Int?
  screenshotUrl String?
  whoisData     String?
  sslInfo       String?
  analyses      ThreatAnalysis[]
  takedowns     TakedownRequest[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([riskScore])
  @@index([domain])
}

model ThreatAnalysis {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  category         String
  confidence       Float
  reasoning        String
  rawResponse      String?
  analyzedAt       DateTime       @default(now())

  @@index([detectedDomainId])
  @@index([category])
}

model TakedownRequest {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  registrar        String
  template         String
  status           String         @default("draft")
  sentAt           DateTime?
  respondedAt      DateTime?
  createdAt        DateTime       @default(now())

  @@index([detectedDomainId])
  @@index([status])
}

model ScanJob {
  id            String   @id @default(uuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  type          String
  status        String   @default("pending")
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  findingsCount Int      @default(0)
  error         String?

  @@index([brandId])
  @@index([status])
}
