generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  hashedPassword String
  name           String?
  role           String        @default("member")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  brands    Brand[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  domain         String
  logoUrl        String?
  keywords       String         @default("")
  whitelistDomains String       @default("")
  senderEmail      String?
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPass         String?
  detectedDomains  DetectedDomain[]
  scanJobs         ScanJob[]
  phishingPatterns PhishingPattern[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([organizationId])
  @@index([domain])
}

model DetectedDomain {
  id            String          @id @default(uuid())
  brandId       String
  brand         Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain        String
  source        String          @default("manual")
  firstSeen     DateTime        @default(now())
  lastSeen      DateTime        @default(now())
  status        String          @default("new_domain")
  riskScore     Int?
  screenshotUrl String?
  whoisData     String?
  sslInfo       String?
  analyses      ThreatAnalysis[]
  takedowns     TakedownRequest[]
  webProbes     WebProbe[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([riskScore])
  @@index([domain])
}

model ThreatAnalysis {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  category         String
  confidence       Float
  reasoning        String
  rawResponse      String?
  analyzedAt       DateTime       @default(now())

  @@index([detectedDomainId])
  @@index([category])
}

model TakedownRequest {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  registrar        String
  abuseEmail       String?
  template         String
  status           String         @default("draft")
  sentAt           DateTime?
  respondedAt      DateTime?
  createdAt        DateTime       @default(now())

  @@index([detectedDomainId])
  @@index([status])
}

model ScanJob {
  id            String   @id @default(uuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  type          String
  status        String   @default("pending")
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  findingsCount Int      @default(0)
  error         String?

  @@index([brandId])
  @@index([status])
}

model WebProbe {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  httpStatus       Int?
  finalUrl         String?
  ip               String?
  htmlSnippet      String?
  headers          String?
  screenshotPath   String?
  dnsResolved      Boolean        @default(false)
  error            String?
  probeAt          DateTime       @default(now())

  @@index([detectedDomainId])
  @@index([probeAt])
}

model PhishingPattern {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  reportedBy  String?
  patternType String   @default("domain_spoof")
  url         String?
  domain      String?
  description String
  tags        String   @default("")
  severity    String   @default("medium")
  status      String   @default("new")
  victimCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([domain])
}
