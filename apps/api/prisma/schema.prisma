generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  hashedPassword String
  name           String?
  role           String        @default("member")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  alertEnabled   Boolean       @default(true)
  alertThreshold Int           @default(60)
  alertLogs      AlertLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
}

model Organization {
  id                   String   @id @default(uuid())
  name                 String
  // 契約プラン: "starter" | "professional" | "enterprise" | "enterprise_plus"
  // Professional以上で JPCERT連動アラート等のPro機能が利用可能
  plan                 String   @default("starter")
  slackWebhookUrl      String?
  slackNotifyEnabled   Boolean  @default(false)
  slackNotifyThreshold Int      @default(60)
  slackNotifyTypes     String   @default("new_threat,site_change,scan_summary")
  brands               Brand[]
  users                User[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Brand {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  domain         String
  logoUrl        String?
  screenshotUrl  String?
  keywords       String         @default("")
  whitelistDomains String       @default("")
  senderEmail      String?
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPass         String?
  trademarkCertUrl String?
  // JPCERT/CC 等の外部フィードからの自動マッチングをスキップするフラグ。
  // ブランド側が独自に JPCERT へ報告している等、自社報告のエコーを避けたい場合に true にする。
  // true でも Pro+組織のブランドとしての他機能（グローバル検知ルール等）は通常通り動作する。
  suppressJpcertAutoMatch Boolean @default(false)
  detectedDomains  DetectedDomain[]
  scanJobs         ScanJob[]
  phishingPatterns PhishingPattern[]
  brandDomains     BrandDomain[]
  socialPosts      SocialPost[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([organizationId])
  @@index([domain])
}

model BrandDomain {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain      String
  type        String   @default("owned") // "primary" | "owned"
  whoisExpiry DateTime?
  createdAt   DateTime @default(now())

  @@unique([brandId, domain])
  @@index([brandId])
  @@index([domain])
}

model DetectedDomain {
  id            String          @id @default(uuid())
  brandId       String
  brand         Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain        String
  source        String          @default("manual")
  firstSeen     DateTime        @default(now())
  lastSeen      DateTime        @default(now())
  status        String          @default("new_domain")
  riskScore     Int?
  screenshotUrl String?
  whoisData     String?
  sslInfo       String?
  // JPCERT/CC フィードで後日確認された日時。
  // nullなら「我々だけが検知」、値ありなら「外部機関も確認済み」の意味。
  // 値 > firstSeen: 我々が先行検知し、後日JPCERTが確認（エコー）
  // 値 < firstSeen: JPCERTが先、我々は後追い（独立した追加情報）
  jpcertConfirmedAt DateTime?
  analyses      ThreatAnalysis[]
  takedowns     TakedownRequest[]
  webProbes     WebProbe[]
  statusLogs    ThreatStatusLog[]
  alertLogs      AlertLog[]
  browserReports BrowserReport[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([riskScore])
  @@index([domain])
  @@index([jpcertConfirmedAt])
}

model ThreatStatusLog {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  fromStatus       String
  toStatus         String
  changedBy        String?
  createdAt        DateTime       @default(now())

  @@index([detectedDomainId])
  @@index([createdAt])
}

model ThreatAnalysis {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  category         String
  confidence       Float
  reasoning        String
  rawResponse      String?
  analyzedAt       DateTime       @default(now())

  @@index([detectedDomainId])
  @@index([category])
}

model TakedownBatch {
  id          String            @id @default(uuid())
  status      String            @default("draft") // draft, sent, partial, completed
  totalCount  Int               @default(0)
  sentCount   Int               @default(0)
  requests    TakedownRequest[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

model TakedownRequest {
  id               String          @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain  @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  batchId          String?
  batch            TakedownBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  recipientType    String          @default("registrar") // registrar, police
  recipientName    String?         // e.g. "警視庁 サイバー犯罪対策課"
  registrar        String
  abuseEmail       String?
  template         String
  language         String          @default("en") // en, ja
  evidenceTypes    String          @default("") // comma-separated: screenshot,trademark,whois
  status           String          @default("draft") // draft, sent, awaiting_response, completed, rejected
  sentAt           DateTime?
  respondedAt      DateTime?
  rejectionReason  String?
  createdAt        DateTime        @default(now())

  @@index([detectedDomainId])
  @@index([batchId])
  @@index([status])
  @@index([recipientType])
}

model ScanJob {
  id            String   @id @default(uuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  type          String
  status        String   @default("pending")
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  findingsCount Int      @default(0)
  error         String?

  @@index([brandId])
  @@index([status])
}

model WebProbe {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  httpStatus       Int?
  finalUrl         String?
  ip               String?
  countryCode      String?
  htmlSnippet      String?
  headers          String?
  screenshotPath   String?
  dnsResolved      Boolean        @default(false)
  error            String?
  probeAt          DateTime       @default(now())

  @@index([detectedDomainId])
  @@index([probeAt])
}

model PhishingPattern {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  reportedBy  String?
  patternType String   @default("domain_spoof")
  url         String?
  domain      String?
  description String
  tags        String   @default("")
  severity    String   @default("medium")
  status      String   @default("new")
  victimCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([domain])
}

model SocialPost {
  id             String   @id @default(uuid())
  platform       String   @default("twitter") // twitter, facebook, instagram, telegram, discord
  postId         String   // platform-specific post ID
  authorHandle   String?
  authorName     String?
  content        String
  urls           String   @default("") // comma-separated detected URLs
  matchedDomain  String?  // matched DetectedDomain
  brandId        String
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  riskScore      Int      @default(0)
  status         String   @default("new") // new, reviewed, dismissed
  postedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([platform, postId])
  @@index([brandId])
  @@index([platform])
  @@index([status])
  @@index([matchedDomain])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model FreeDiagnosis {
  id            String   @id @default(uuid())
  email         String
  targetUrl     String
  domain        String   // extracted from targetUrl
  riskScore     Int?
  category      String?  // phishing, brand_abuse, parked, legitimate, unknown
  confidence    Float?
  reasoning     String?
  screenshotUrl String?
  htmlSnippet   String?
  dnsResolved   Boolean  @default(false)
  httpStatus    Int?
  finalUrl      String?
  ip            String?
  sslInfo       String?
  whoisData     String?
  status        String   @default("pending") // pending, scanning, completed, failed
  error         String?
  expiresAt     DateTime // created_at + 7 days
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@index([status])
}

model BrowserReport {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  provider         String         // GOOGLE_SAFE_BROWSING | MICROSOFT_SMARTSCREEN
  status           String         @default("pending") // pending, submitted, confirmed, rejected, error
  submittedUrl     String
  operationId      String?        // Google Web Risk long-running operation ID
  submittedAt      DateTime?
  confirmedAt      DateTime?
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([detectedDomainId, provider])
  @@index([detectedDomainId])
  @@index([provider])
  @@index([status])
}

model GlobalDetectionRule {
  id          String   @id @default(uuid())
  domain      String   @unique
  patternType String   @default("domain_spoof")
  description String
  tags        String   @default("")
  severity    String   @default("medium")
  victimCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domain])
  @@index([severity])
}

// 第三者機関（JPCERT/CC等）が過去にフィッシングURLとして観測した履歴
// 無料診断の即時判定とリスクスコア加点に利用
model KnownPhishingUrl {
  id          String   @id @default(uuid())
  url         String   // JPCERTが記録した完全URL
  domain      String   // URLから抽出した小文字hostname（検索用）
  brandLabel  String   // JPCERTのdescription列（例: "Apple ID", "国税庁"）
  observedAt  DateTime // JPCERT/CCが確認した日時
  source      String   @default("jpcert") // 拡張時に他フィードを区別するため
  importedAt  DateTime @default(now())

  @@unique([source, url])
  @@index([domain])
  @@index([brandLabel])
  @@index([observedAt])
}

// Layer 4: JPCERTコーパスから機械的に抽出した検知パターン
// domain_keyword: ドメインラベル内の高頻度n-gram（例: "login", "secure"）
// path_prefix:    URLパスの最初のセグメント（例: "/signin", "/verify"）
// tld_abuse:      フィッシングで比率が高いTLD（例: ".xyz"）
// subdomain:      サブドメインで多用されるラベル（例: "secure-", "mail-"）
model JpcertLearnedPattern {
  id          String   @id @default(uuid())
  patternType String   // "domain_keyword" | "path_prefix" | "tld_abuse" | "subdomain"
  pattern     String   // パターン文字列
  occurrences Int      @default(0)  // マッチしたKnownPhishingUrl件数
  precision   Float    @default(0)  // 0.0-1.0: パターンの識別能力（高いほど偽陽性が少ない）
  examples    String   @default("") // JSON配列: サンプルURL 3件
  lastSeen    DateTime                // パターンを最後に観測した日時
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([patternType, pattern])
  @@index([patternType])
  @@index([precision])
  @@index([occurrences])
}

// 外部脅威フィード（JPCERT等）取り込みの実行履歴
// Layer B: 管理画面で更新状況を可視化、Layer A: Slack通知の元データ
model FeedImportRun {
  id            String    @id @default(uuid())
  source        String    // "jpcert"
  status        String    @default("running") // "running" | "success" | "failed"
  fetchedCount  Int       @default(0)         // CSVから取得した行数
  insertedCount Int       @default(0)         // 新規DBインサート件数（重複除く）
  brandHitCount Int       @default(0)         // Pro+組織の登録ブランドに該当した件数（新規+既存確認の合計、後方互換）
  newBrandHits  Int       @default(0)         // 当方未検知だった新規URL（純粋にJPCERT経由で初把握）
  confirmedBrandHits Int  @default(0)         // 既検知ドメインの外部確認（エコー）
  alertedOrgIds String    @default("")        // 通知対象組織IDのCSV
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  error         String?
  metadata      String?   // JSON: 年月別件数等の詳細

  @@index([source])
  @@index([startedAt])
  @@index([status])
}

model AlertLog {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  type             String
  subject          String
  sentAt           DateTime       @default(now())
  status           String         @default("sent")
  error            String?

  @@index([userId])
  @@index([detectedDomainId])
  @@index([sentAt])
}

model ActivityLog {
  id             String   @id @default(uuid())
  userId         String?
  userEmail      String
  userName       String?
  organizationId String?
  action         String
  category       String
  method         String
  path           String
  statusCode     Int?
  ipAddress      String?
  metadata       String?
  duration       Int?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([category])
  @@index([createdAt])
  @@index([userEmail])
}
