generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  hashedPassword String
  name           String?
  role           String        @default("member")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  alertEnabled   Boolean       @default(true)
  alertThreshold Int           @default(60)
  alertLogs      AlertLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

model Organization {
  id                   String   @id @default(uuid())
  name                 String
  slackWebhookUrl      String?
  slackNotifyEnabled   Boolean  @default(false)
  slackNotifyThreshold Int      @default(60)
  slackNotifyTypes     String   @default("new_threat,site_change,scan_summary")
  brands               Brand[]
  users                User[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Brand {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  domain         String
  logoUrl        String?
  screenshotUrl  String?
  keywords       String         @default("")
  whitelistDomains String       @default("")
  senderEmail      String?
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPass         String?
  trademarkCertUrl String?
  detectedDomains  DetectedDomain[]
  scanJobs         ScanJob[]
  phishingPatterns PhishingPattern[]
  brandDomains     BrandDomain[]
  socialPosts      SocialPost[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([organizationId])
  @@index([domain])
}

model BrandDomain {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain      String
  type        String   @default("owned") // "primary" | "owned"
  whoisExpiry DateTime?
  createdAt   DateTime @default(now())

  @@unique([brandId, domain])
  @@index([brandId])
  @@index([domain])
}

model DetectedDomain {
  id            String          @id @default(uuid())
  brandId       String
  brand         Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain        String
  source        String          @default("manual")
  firstSeen     DateTime        @default(now())
  lastSeen      DateTime        @default(now())
  status        String          @default("new_domain")
  riskScore     Int?
  screenshotUrl String?
  whoisData     String?
  sslInfo       String?
  analyses      ThreatAnalysis[]
  takedowns     TakedownRequest[]
  webProbes     WebProbe[]
  statusLogs    ThreatStatusLog[]
  alertLogs     AlertLog[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([riskScore])
  @@index([domain])
}

model ThreatStatusLog {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  fromStatus       String
  toStatus         String
  changedBy        String?
  createdAt        DateTime       @default(now())

  @@index([detectedDomainId])
  @@index([createdAt])
}

model ThreatAnalysis {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  category         String
  confidence       Float
  reasoning        String
  rawResponse      String?
  analyzedAt       DateTime       @default(now())

  @@index([detectedDomainId])
  @@index([category])
}

model TakedownBatch {
  id          String            @id @default(uuid())
  status      String            @default("draft") // draft, sent, partial, completed
  totalCount  Int               @default(0)
  sentCount   Int               @default(0)
  requests    TakedownRequest[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

model TakedownRequest {
  id               String          @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain  @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  batchId          String?
  batch            TakedownBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  registrar        String
  abuseEmail       String?
  template         String
  language         String          @default("en") // en, ja
  evidenceTypes    String          @default("") // comma-separated: screenshot,trademark,whois
  status           String          @default("draft") // draft, sent, awaiting_response, completed, rejected
  sentAt           DateTime?
  respondedAt      DateTime?
  rejectionReason  String?
  createdAt        DateTime        @default(now())

  @@index([detectedDomainId])
  @@index([batchId])
  @@index([status])
}

model ScanJob {
  id            String   @id @default(uuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  type          String
  status        String   @default("pending")
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  findingsCount Int      @default(0)
  error         String?

  @@index([brandId])
  @@index([status])
}

model WebProbe {
  id               String         @id @default(uuid())
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  httpStatus       Int?
  finalUrl         String?
  ip               String?
  htmlSnippet      String?
  headers          String?
  screenshotPath   String?
  dnsResolved      Boolean        @default(false)
  error            String?
  probeAt          DateTime       @default(now())

  @@index([detectedDomainId])
  @@index([probeAt])
}

model PhishingPattern {
  id          String   @id @default(uuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  reportedBy  String?
  patternType String   @default("domain_spoof")
  url         String?
  domain      String?
  description String
  tags        String   @default("")
  severity    String   @default("medium")
  status      String   @default("new")
  victimCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([domain])
}

model SocialPost {
  id             String   @id @default(uuid())
  platform       String   @default("twitter") // twitter, facebook, instagram, telegram, discord
  postId         String   // platform-specific post ID
  authorHandle   String?
  authorName     String?
  content        String
  urls           String   @default("") // comma-separated detected URLs
  matchedDomain  String?  // matched DetectedDomain
  brandId        String
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  riskScore      Int      @default(0)
  status         String   @default("new") // new, reviewed, dismissed
  postedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([platform, postId])
  @@index([brandId])
  @@index([platform])
  @@index([status])
  @@index([matchedDomain])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model FreeDiagnosis {
  id            String   @id @default(uuid())
  email         String
  targetUrl     String
  domain        String   // extracted from targetUrl
  riskScore     Int?
  category      String?  // phishing, brand_abuse, parked, legitimate, unknown
  confidence    Float?
  reasoning     String?
  screenshotUrl String?
  htmlSnippet   String?
  dnsResolved   Boolean  @default(false)
  httpStatus    Int?
  finalUrl      String?
  ip            String?
  sslInfo       String?
  whoisData     String?
  status        String   @default("pending") // pending, scanning, completed, failed
  error         String?
  expiresAt     DateTime // created_at + 7 days
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@index([status])
}

model AlertLog {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  detectedDomainId String
  detectedDomain   DetectedDomain @relation(fields: [detectedDomainId], references: [id], onDelete: Cascade)
  type             String
  subject          String
  sentAt           DateTime       @default(now())
  status           String         @default("sent")
  error            String?

  @@index([userId])
  @@index([detectedDomainId])
  @@index([sentAt])
}
